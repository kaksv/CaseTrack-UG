# ── CaseTrack UG API ─────────────────────────────────────────────
# Copy to api/.env and fill in real values. Never commit api/.env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/casetrack_ug)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/casetrack_ug?retryWrites=true&w=majority

# Use a long random value (at least 32 characters). Example:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins. No wildcards.
CORS_ORIGINS=http://localhost:3000,https://casetrackug.vercel.app

# Number of reverse proxies in front of the API (Caddy = 1)
TRUST_PROXY=1

# Hugging Face Gemma chat provider
HUGGINGFACE_API_KEY=hf_replace_me
GEMMA_MODEL=google/gemma-3-4b-it
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ElevenLabs speech-to-text and text-to-speech
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_ID=replace_me
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

LEGAL_ASSISTANT_ENABLED=true
LEGAL_ASSISTANT_MAX_MESSAGE_LENGTH=3000

# Fully local provider configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
STT_PROVIDER=whisper
WHISPER_MODEL=/Volumes/SOMA-DISK/casetrack-ai/whisper/whisper.cpp/models/ggml-small.bin
TTS_PROVIDER=browser
